{
  "name": "generative-music-studio",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@12.10.1",
  "scripts": {
    "build:shared": "pnpm --filter @gms/shared build",
    "dev:shared": "pnpm --filter @gms/shared dev",
    "build:api": "pnpm run build:shared && pnpm --filter api run build",
    "clean:api": "pnpm --filter api run clean:dist",
    "dev:api": "pnpm --filter api start:dev",
    "dev:web": "pnpm --filter web dev",
    "build": "pnpm run build:api && pnpm --filter web build"
  }
}
