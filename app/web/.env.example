# Local development needs two public environment variables. Both are
# NEXT_PUBLIC_* and are inlined into the client bundle at build time, so they
# must be set in the build environment of the host, not only at runtime.
#
# On Vercel, set NEXT_PUBLIC_API_URL=/api for the browser and leave API_URL
# alone: the service binding injects it for server-side calls.

# Base URL of the Generative Music Studio API (no trailing slash).
# The API defaults to port 3000, which collides with `next dev`, so run it on a
# different port (for example `PORT=4000 pnpm dev:api`) and point the web app here.
NEXT_PUBLIC_API_URL=http://localhost:4000

# Absolute URL of the deploy, used for Open Graph/metadata. Optional; defaults
# to http://localhost:3000.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
