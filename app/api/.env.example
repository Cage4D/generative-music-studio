# Copy this file to .env and adjust the values for your machine.
# The e2e tests derive their own DATABASE_URL from this one by swapping the
# database name for generative_music_studio_test (see scripts/e2e-db.mjs).
DATABASE_URL="postgresql://music_studio_user:music_studio_user@localhost:5432/generative_music_studio"

# Port the API listens on. Defaults to 3000 in code, which collides with the
# Next.js dev server; the web client expects http://localhost:4000 by default.
PORT=4000