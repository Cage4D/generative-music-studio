# Copy this file to .env and adjust the values for your machine.
# The e2e tests derive their own DATABASE_URL from this one by swapping the
# database name for generative_music_studio_test (see scripts/e2e-db.mjs).
DATABASE_URL="postgresql://music_studio_user:music_studio_user@localhost:5432/generative_music_studio"

# Port the API listens on. Defaults to 3000 in code, which collides with the
# Next.js dev server; the web client expects http://localhost:4000 by default.
PORT=4000

# Comma separated list of browser origins allowed to call the API. A wildcard
# ("*") is rejected when NODE_ENV=production, so list real origins there.
CORS_ORIGINS=http://localhost:3000

# How many proxy hops to trust when resolving the client IP. The rate limiter
# keys on this IP, so it must be the real client and not the proxy.
TRUST_PROXY=1

# Requests allowed per client IP per window. Set RATE_LIMIT_MAX=0 to disable.
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_MS=60000
