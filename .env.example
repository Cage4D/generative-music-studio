# --- Database (PostgreSQL) ---
# Connection string for the app database. Drizzle reads this for migrations
# (`npm run db:*`) and the runtime client connects on first query.
DATABASE_URL="postgres://postgres:postgres@localhost:5432/nextjs_template"

# --- better-auth ---
# Secret used to sign session cookies / tokens. Use a long random string.
# Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
# Public base URL of the app (the browser must be able to reach it).
BETTER_AUTH_URL="http://localhost:3000"

# Email/password auth toggle: set to "false" to disable it entirely.
AUTH_EMAIL_PASSWORD="true"

# Social providers to expose in the UI (comma-separated). Each provider is
# only enabled server-side when its client id + secret are also set.
NEXT_PUBLIC_AUTH_SOCIAL_PROVIDERS="github,google"

# GitHub OAuth app: https://github.com/settings/developers
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Google OAuth app: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Misc ---
# Optional: logging level for pino ("debug" | "info" | "warn" | "error")
LOG_LEVEL="info"